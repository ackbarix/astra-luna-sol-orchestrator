#!/bin/sh
# als-task — Shared team task list (Claude Code TaskCreate/TaskUpdate equivalent).
# POSIX sh wrapper: runs the als_flow.task module with this checkout on PYTHONPATH.
set -eu
pkg_parent=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PYTHONPATH="$pkg_parent${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "${ALS_PYTHON:-python3}" -m als_flow.task "$@"
