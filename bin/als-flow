#!/bin/sh
# als-flow — Run and inspect als_flow workflow scripts (Claude Code Workflow equivalent).
# POSIX sh wrapper: runs the als_flow.cli module with this checkout on PYTHONPATH.
set -eu
pkg_parent=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PYTHONPATH="$pkg_parent${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "${ALS_PYTHON:-python3}" -m als_flow.cli "$@"
